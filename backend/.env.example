# Trendora - Mühit dəyişənləri
# ------------------------------------------------------------------
# Bu faylı `.env` adı ilə kopyalayın və öz dəyərlərinizi doldurun.
# `.env` faylı HEÇ VAXT git-ə commit edilməməlidir (bax: .gitignore).

# MongoDB Atlas qoşulma sətri.
# <DB_PASSWORD> yerinə MongoDB Atlas-dakı `trendorainfocall_db_user`
# istifadəçisinin əsl şifrəsini yazın. Şifrə heç vaxt kodda saxlanılmır,
# yalnız bu fayldan (mühit dəyişənindən) oxunur.
MONGODB_URI=mongodb+srv://trendorainfocall_db_user:<DB_PASSWORD>@trendora.rlqrv1r.mongodb.net/trendora?retryWrites=true&w=majority&appName=Trendora

# JWT token imzalamaq üçün gizli açar (production-da mütləq dəyişdirin)
JWT_SECRET=trendora-dev-secret-CHANGE-IN-PRODUCTION

# Serverin dinləyəcəyi port (Render kimi platformalarda avtomatik təyin olunur)
PORT=4000

# Cloudinary - rəy şəkillərinin yükləndiyi bulud saxlama xidməti.
# Dəyərləri https://cloudinary.com/console ünvanındakı Dashboard-dan götürün.
# Bu dəyərlər HEÇ VAXT koda yazılmır, yalnız buradan (mühit dəyişənindən) oxunur.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

